{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:agi-alpha:inspection-audit:report:0.1",
  "type": "object", "additionalProperties": false,
  "required": ["schema_version", "instrument_version", "identity", "mission", "mission_result", "facts",
    "findings", "geometry", "traces", "existing_reference", "family_proofs", "repair_requests", "limitations", "execution"],
  "properties": {
    "schema_version": {"const": "0.1"}, "instrument_version": {"type": "string"},
    "identity": {"type": "object", "required": ["files", "dependencies", "assets", "mission_hash", "request_hash", "complete_identity_sha256"]},
    "mission": {"type": "object", "required": ["id", "purpose", "statement"]},
    "mission_result": {"type": "object", "required": ["status", "reasons", "physical_reuse_admitted"],
      "properties": {"status": {"enum": ["supported_audit", "conditional", "refuted", "unsupported", "blocked"]},
        "reasons": {"type": "array", "items": {"type": "string"}}, "physical_reuse_admitted": {"const": false}}},
    "facts": {"type": "object", "required": ["source_qif", "incoming_qif"], "additionalProperties": false,
      "properties": {"source_qif": {"$ref": "#/$defs/document"}, "incoming_qif": {"$ref": "#/$defs/document"}}},
    "findings": {"type": "array", "items": {"type": "object",
      "required": ["id", "kind", "status", "evidence_basis", "conclusion", "refs", "details", "limitations"],
      "properties": {"evidence_basis": {"enum": ["observed_source", "derived", "researcher_counterfactual"]},
        "refs": {"type": "array", "items": {"$ref": "#/$defs/reference"}}}}},
    "geometry": {"type": "object", "required": ["status", "correspondences"]},
    "traces": {"type": "array", "items": {"type": "object", "required": ["characteristic_id", "nominal_id",
      "definition_id", "actual_id", "actual_value", "feature_actual_id", "feature_item_id", "geometry",
      "measurement_result", "refs", "physical_release"], "properties": {"physical_release": {"const": false}}}},
    "existing_reference": {"type": "object", "required": ["status"]},
    "family_proofs": {"type": "array", "items": {"type": "object", "required": ["basis", "source_ids",
      "incoming_id", "status", "physical_reuse_admitted", "guard_status", "guard_evidence_authenticated", "refs"],
      "properties": {"physical_reuse_admitted": {"const": false}, "guard_evidence_authenticated": {"const": false},
        "basis": {"enum": ["formal_source_interpretation", "researcher_counterfactual"]}}}},
    "repair_requests": {"type": "array", "items": {"type": "object", "required": ["id", "required_evidence",
      "reason", "affected", "status", "mission_id"]}},
    "limitations": {"type": "array", "items": {"type": "string"}},
    "execution": {"type": "object", "required": ["elapsed_seconds", "network_calls", "input_mutations",
      "development_and_evaluation_cost_included"], "properties": {"network_calls": {"const": 0},
      "input_mutations": {"const": 0}, "development_and_evaluation_cost_included": {"const": false}}}
  },
  "$defs": {
    "reference": {"type": "object", "required": ["asset", "sha256", "element_id", "line", "field"],
      "properties": {"asset": {"type": "string"}, "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
        "element_id": {"type": ["string", "null"]}, "line": {"type": ["integer", "null"]}, "field": {"type": "string"}}},
    "quantity": {"type": ["object", "null"], "required": ["raw", "unit_name", "factor_to_metre", "si", "basis", "ref"],
      "properties": {"raw": {"type": "string"}, "si": {"type": "string"}, "ref": {"$ref": "#/$defs/reference"}}},
    "characteristic": {"type": "object", "required": ["id", "kind", "name", "target", "interval", "features",
      "nominal_id", "definition_id", "supported_predicate", "refs", "actuals"],
      "properties": {"target": {"$ref": "#/$defs/quantity"},
        "interval": {"type": ["object", "null"], "required": ["low_si", "high_si", "unit", "defined_as_limit"]},
        "refs": {"type": "array", "items": {"$ref": "#/$defs/reference"}},
        "actuals": {"type": "array", "items": {"type": "object", "required": ["id", "value", "raw_value_literal",
          "status", "feature_actual_ids", "result_id", "ref"], "properties": {"value": {"$ref": "#/$defs/quantity"}}}}}},
    "document": {"type": "object", "required": ["asset", "sha256", "version", "primary_linear_unit", "counterfactual",
      "formal_standard_literals", "characteristics", "features", "feature_actuals", "measurement_results"],
      "properties": {"version": {"const": "2.1.0"}, "counterfactual": {"const": false},
        "characteristics": {"type": "array", "items": {"$ref": "#/$defs/characteristic"}}}}
  }
}
