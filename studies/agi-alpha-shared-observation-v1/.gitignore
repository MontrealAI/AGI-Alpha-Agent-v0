# Reconstructible isolated replay workspaces; compact receipts live in evidence/.
reproduction/
__pycache__/
*.py[cod]

# LaTeX intermediates; preserve generated PDF/TeX and publication source.
paper/*.aux
paper/*.log
paper/*.out
paper/*.toc
paper/*.fls
paper/*.fdb_latexmk
paper/*.synctex.gz

# Retain only the two declared reproducibility command-log collections.
!evidence/reproducibility-v1/logs/
!evidence/reproducibility-v1/logs/*.txt
!evidence/reproducibility-v2/logs/
!evidence/reproducibility-v2/logs/*.txt
