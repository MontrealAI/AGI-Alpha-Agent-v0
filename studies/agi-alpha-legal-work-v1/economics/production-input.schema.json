{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Aggregated executed legal-work production records",
  "type": "object",
  "required": ["records"],
  "properties": {
    "records": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["case_id", "arm", "accepted_deterministic", "professional_acceptance", "runtime_seconds", "attempts", "escalation_required"],
        "properties": {
          "case_id": {"type": "string", "pattern": "^[A-Za-z0-9._:-]{1,80}$"},
          "arm": {"enum": ["B", "C1", "C", "D"]},
          "implementation_stage": {"type": "string"},
          "accepted_deterministic": {"type": "boolean"},
          "professional_acceptance": {"enum": ["unknown", "accepted", "rejected"]},
          "runtime_seconds": {"type": "number", "minimum": 0},
          "attempts": {"type": "integer", "minimum": 1},
          "escalation_required": {"type": "boolean"},
          "professional_review_minutes": {"type": ["number", "null"], "minimum": 0}
        }
      }
    }
  },
  "$comment": "Each stage must contain exactly the same case IDs, one aggregate per case; all failed and correction attempts must be included in runtime and attempts. Validator enforces these invariants. Never populate unknown professional acceptance with technical acceptance."
}
