","CpusetMems":"0","Memory":314572800,"MemoryReservation":209715200,"MemorySwap":514288000,"RestartPolicy":{"MaximumRetryCount":4,"Name":"on-failure"}}}}}}}}}}}},"/containers/{id}/wait":{"operations":{"modified":{"POST":{"parameters":{"modified":{"query":{"condition":{"description":{"from":"Wait until a container state reaches the given condition, either\n'not-running' (default), 'next-exit', or 'removed'.\n","to":"Wait until a container state reaches the given condition.\n\nDefaults to `not-running` if omitted or empty.\n"},"schema":{"enum":{"enumAdded":true,"added":["not-running","next-exit","removed"]}}}}}},"responses":{"added":["400"],"modified":{"200":{"content":{"modified":{"application/json":{"schema":{"extensions":{"added":["x-go-name"]},"properties":{"modified":{"Error":{"extensions":{"added":["x-go-name"]}},"StatusCode":{"format":{"from":"","to":"int64"}}}}}}}}}}}}}}},"/distribution/{name}/json":{"operations":{"modified":{"GET":{"responses":{"modified":{"200":{"content":{"modified":{"application/json":{"schema":{"description":{"from":"","to":"Describes the result obtained from contacting the registry to retrieve\nimage metadata.\n"},"properties":{"modified":{"Descriptor":{"extensions":{"added":["x-go-name"]},"description":{"from":"A descriptor struct containing digest, media type, and size.\n","to":"A descriptor struct containing digest, media type, and size, as defined in\nthe [OCI Content Descriptors Specification](https://github.com/opencontainers/image-spec/blob/v1.0.1/descriptor.md).\n"},"properties":{"added":["mediaType","digest","size"],"deleted":["Size","URLs","Digest","MediaType"]}},"Platforms":{"items":{"extensions":{"added":["x-go-name"]},"description":{"from":"","to":"Describes the platform which the image in the manifest runs on, as defined\nin the [OCI Image Index Specification](https://github.com/opencontainers/image-spec/blob/v1.0.1/image-index.md).\n"},"properties":{"added":["variant","architecture","os","os.version","os.features"],"deleted":["Variant","Architecture","Features","OS","OSFeatures","OSVersion"]}}}}}},"examples":{"deleted":["response"]}}}}}}}}}}},"/events":{"operations":{"modified":{"GET":{"responses":{"modified":{"200":{"content":{"modified":{"application/json":{"schema":{"description":{"from":"","to":"EventMessage represents the information an event contains.\n"},"properties":{"added":["scope"],"modified":{"Action":{"example":{"from":null,"to":"create"}},"Actor":{"description":{"from":"","to":"Actor describes something that generates events, like a container, network,\nor a volume.\n"},"properties":{"modified":{"Attributes":{"description":{"from":"Various key/value attributes of the object, depending on its type","to":"Various key/value attributes of the object, depending on its type.\n"},"example":{"from":null,"to":{"com.example.some-label":"some-label-value","image":"alpine:latest","name":"my-container"}}},"ID":{"example":{"from":null,"to":"ede54ee1afda366ab42f824e8a5ffd195155d853ceaec74a927f249ea270c743"}}}}},"Type":{"enum":{"enumAdded":true,"added":["builder","config","container","daemon","image","network","node","plugin","secret","service","volume"]},"example":{"from":null,"to":"container"}},"time":{"format":{"from":"","to":"int64"},"example":{"from":null,"to":1629574695}},"timeNano":{"example":{"from":null,"to":1629574695515050000}}}}},"examples":{"deleted":["response"]}}}}}}}}}}},"/exec/{id}/resize":{"operations":{"modified":{"POST":{"responses":{"added":["400","500","200"],"deleted":["201"]}}}}},"/exec/{id}/start":{"operations":{"modified":{"POST":{"requestBody":{"content":{"modified":{"application/json":{"schema":{"title":{"from":"","to":"ExecStartConfig"},"example":{"from":{"Detach":false,"Tty":false},"to":{"ConsoleSize":[80,64],"Detach":false,"Tty":true}},"properties":{"added":["ConsoleSize"]}}}}}},"responses":{"modified":{"404":{"content":{"added":["application/vnd.docker.multiplexed-stream"]}},"409":{"content":{"added":["application/vnd.docker.multiplexed-stream"]}}}}}}}},"/images/create":{"operations":{"modified":{"POST":{"parameters":{"added":{"query":["changes"]},"modified":{"query":{"platform":{"description":{"from":"Platform in the format os[/arch[/variant]]","to":"Platform in the format os[/arch[/variant]].\n\nWhen used in combination with the `fromImage` option, the daemon checks\nif the given image is present in the local image cache with the given\nOS and Architecture, and otherwise attempts to pull the image. If the\noption is not set, the host's native OS and Architecture are used.\nIf the given image does not exist in the local image cache, the daemon\nattempts to pull the image with the host's native OS and Architecture.\nIf the given image does exists in the local image cache, but its OS or\narchitecture does not match, a warning is produced.\n\nWhen used with the `fromSrc` option to import an image from an archive,\nthis option sets the platform information for the imported image. If\nthe option is not set, the host's native OS and Architecture are used\nfor the imported image.\n"}}}}}}}}},"/images/json":{"operations":{"modified":{"GET":{"parameters":{"added":{"query":["shared-size"]}},"responses":{"modified":{"200":{"content":{"modified":{"application/json":{"schema":{"items":{"properties":{"modified":{"Containers":{"description":{"from":"","to":"Number of containers using this image. Includes both stopped and running\ncontainers.\n\nThis size is not calculated by default, and depends on which API endpoint\nis used. `-1` indicates that the value has not been set / calculated.\n"},"example":{"from":null,"to":2}},"Created":{"description":{"from":"","to":"Date and time at which the image was created as a Unix timestamp\n(number of seconds sinds EPOCH).\n"},"example":{"from":null,"to":"1644009612"}},"Id":{"description":{"from":"","to":"ID is the content-addressable ID of an image.\n\nThis identifier is a content-addressable digest calculated from the\nimage's configuration (which includes the digests of layers used by\nthe image).\n\nNote that this digest differs from the `RepoDigests` below, which\nholds digests of image manifests that reference the image.\n"},"example":{"from":null,"to":"sha256:ec3f0931a6e6b6855d76b2d7b0be30e81860baccd891b2e243280bf1cd8ad710"}},"Labels":{"description":{"from":"","to":"User-defined key/value metadata."},"example":{"from":null,"to":{"com.example.some-label":"some-value","com.example.some-other-label":"some-other-value"}}},"ParentId":{"description":{"from":"","to":"ID of the parent image.\n\nDepending on how the image was created, this field may be empty and\nis only set for images that were built/created locally. This field\nis empty if the image was pulled from an image registry.\n"},"example":{"from":null,"to":""}},"RepoDigests":{"description":{"from":"","to":"List of content-addressable digests of locally available image manifests\nthat the image is referenced from. Multiple manifests can refer to the\nsame image.\n\nThese digests are usually only available if the image was either pulled\nfrom a registry, or if the image was pushed to a registry, which is when\nthe manifest is generated and its digest calculated.\n"},"example":{"from":null,"to":["example@sha256:afcc7f1ac1b49db317a7196c902e61c6c3c4607d63599ee1a82d702d249a0ccb","internal.registry.example.com:5000/example@sha256:b69959407d21e8a062e0416bf13405bb2b71ed7a84dde4158ebafacfa06f5578"]}},"RepoTags":{"description":{"from":"","to":"List of image names/tags in the local image cache that reference this\nimage.\n\nMultiple image tags can refer to the same image, and this list may be\nempty if no tags reference the image, in which case the image is\n\"untagged\", in which case it can still be referenced by its ID.\n"},"example":{"from":null,"to":["example:1.0","example:latest","example:stable","internal.registry.example.com:5000/example:1.0"]}},"SharedSize":{"format":{"from":"","to":"int64"},"description":{"from":"","to":"Total size of image layers that are shared between this image and other\nimages.\n\nThis size is not calculated by default. `-1` indicates that the value\nhas not been set / calculated.\n"},"example":{"from":null,"to":1239828}},"Size":{"format":{"from":"","to":"int64"},"description":{"from":"","to":"Total size of the image including all layers it is composed of.\n"},"example":{"from":null,"to":172064416}},"VirtualSize":{"format":{"from":"","to":"int64"},"description":{"from":"","to":"Total size of the image including all layers it is composed of.\n\nIn versions of Docker before v1.10, this field was calculated from\nthe image itself and all of its parent images. Docker v1.10 and up\nstore images self-contained, and no longer use a parent-chain, making\nthis field an equivalent of the Size field.\n\nThis field is kept for backward compatibility, but may be removed in\na future version of the API.\n"},"example":{"from":null,"to":172064416}}}}}},"examples":{"deleted":["response"]}}}}}}}}}}},"/images/{name}/json":{"operations":{"modified":{"GET":{"responses":{"modified":{"200":{"content":{"modified":{"application/json":{"schema":{"description":{"from":"","to":"Information about an image in the local image cache.\n"},"required":{"deleted":["Size","Architecture","GraphDriver","RootFS","Id","VirtualSize","Parent","Container","DockerVersion","Author","Os","Comment","Created"]},"properties":{"added":["Variant"],"modified":{"Architecture":{"description":{"from":"","to":"Hardware CPU architecture that the image runs on.\n"},"example":{"from":null,"to":"arm"}},"Author":{"description":{"from":"","to":"Name of the author that was specified when committing the image, or as\nspecified through MAINTAINER (deprecated) in the Dockerfile.\n"},"example":{"from":null,"to":""}},"Comment":{"description":{"from":"","to":"Optional message that was set when committing or importing the image.\n"},"example":{"from":null,"to":""}},"Config":{"description":{"from":"Configuration for a container that is portable between hosts","to":"Configuration for a container that is p