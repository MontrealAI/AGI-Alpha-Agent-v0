39f4e91bd1d"}},"Image":{"description":{"from":"The name of the image to use when creating the container/\n","to":"The name (or reference) of the image to use when creating the container,\nor which was used when the container was created.\n"},"example":{"from":null,"to":"example-image:1.0"}},"Labels":{"example":{"from":null,"to":{"com.example.some-label":"some-value","com.example.some-other-label":"some-other-value"}}},"MacAddress":{"nullable":{"from":false,"to":true}},"NetworkDisabled":{"nullable":{"from":false,"to":true}},"OnBuild":{"example":{"from":null,"to":[]},"nullable":{"from":false,"to":true}},"Shell":{"example":{"from":null,"to":["/bin/sh","-c"]},"nullable":{"from":false,"to":true}},"StopSignal":{"default":{"from":"SIGTERM","to":null},"example":{"from":null,"to":"SIGTERM"},"nullable":{"from":false,"to":true}},"StopTimeout":{"nullable":{"from":false,"to":true}},"WorkingDir":{"example":{"from":null,"to":"/public/"}}}}}},{"base":{"index":1},"revision":{"index":1},"diff":{"properties":{"modified":{"HostConfig":{"allOf":{"modified":[{"base":{"index":0,"component":"Resources"},"revision":{"index":0,"component":"Resources"},"diff":{"properties":{"added":["NanoCpus"],"deleted":["KernelMemory","NanoCPUs"],"modified":{"KernelMemoryTCP":{"description":{"from":"Hard limit for kernel TCP buffer memory (in bytes).","to":"Hard limit for kernel TCP buffer memory (in bytes). Depending on the\nOCI runtime in use, this option may be ignored. It is no longer supported\nby the default (runc) runtime.\n\nThis field is omitted when empty.\n"}}}}}},{"base":{"index":1},"revision":{"index":1},"diff":{"properties":{"modified":{"ConsoleSize":{"description":{"from":"Initial console size, as an `[height, width]` array. (Windows only)\n","to":"Initial console size, as an `[height, width]` array.\n"},"nullable":{"from":false,"to":true}},"Mounts":{"items":{"properties":{"modified":{"BindOptions":{"properties":{"added":["CreateMountpoint"]}},"Type":{"description":{"from":"The mount type. Available types:\n\n- `bind` Mounts a file or directory from the host into the container. Must exist prior to creating the container.\n- `volume` Creates a volume with the given name and options (or uses a pre-existing volume with the same name and options). These are **not** removed when the container is removed.\n- `tmpfs` Create a tmpfs with the given options. The mount source cannot be specified for tmpfs.\n- `npipe` Mounts a named pipe from the host into the container. Must exist prior to creating the container.\n","to":"The mount type. Available types:\n\n- `bind` Mounts a file or directory from the host into the container. Must exist prior to creating the container.\n- `volume` Creates a volume with the given name and options (or uses a pre-existing volume with the same name and options). These are **not** removed when the container is removed.\n- `tmpfs` Create a tmpfs with the given options. The mount source cannot be specified for tmpfs.\n- `npipe` Mounts a named pipe from the host into the container. Must exist prior to creating the container.\n- `cluster` a Swarm cluster volume\n"},"enum":{"added":["cluster"]}}}}}},"RestartPolicy":{"properties":{"modified":{"Name":{"description":{"from":"- Empty string means not to restart\n- `always` Always restart\n- `unless-stopped` Restart always except when the user has manually stopped the container\n- `on-failure` Restart only when the container exit code is non-zero\n","to":"- Empty string means not to restart\n- `no` Do not automatically restart\n- `always` Always restart\n- `unless-stopped` Restart always except when the user has manually stopped the container\n- `on-failure` Restart only when the container exit code is non-zero\n"},"enum":{"added":["no"]}}}}},"SecurityOpt":{"description":{"from":"A list of string values to customize labels for MLS systems, such as SELinux.","to":"A list of string values to customize labels for MLS systems, such\nas SELinux.\n"}}}}}}]}}}}}}]},"example":{"from":{"AttachStderr":tru