  "formalFindings": [
    {
      "thread": "PRRT_kwDONwDjTc6vvggS",
      "commentId": 4363365163,
      "priority": "P2",
      "problem": "Cancellation during awaited first bridge initialization was observed only after bridge.run launched.",
      "correction": "Recheck the same live AbortSignal immediately after initialization and before run."
    },
    {
      "thread": "PRRT_kwDONwDjTc6vvggd",
      "commentId": 4363365179,
      "priority": "P2",
      "problem": "A rejected cached initializer permanently poisoned all later attempts.",
      "correction": "On rejection clear only the identical cached initializer. Retain successful initialization and do not clear a newer promise when a stale waiter fails."
    }
  ],
