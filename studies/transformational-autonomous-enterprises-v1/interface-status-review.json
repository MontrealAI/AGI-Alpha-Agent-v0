    "path": "study/interface/app.js",
    "problem": "A reload or second page observes initial busy:true without owning a pending /api/run request, so the one-time status response leaves its run and restore controls disabled after the server finishes.",
    "refreshedThreadUnresolved": true
  },
  "change": {
    "appBeforeSha256": "55c99dc57a7e23f9a238cfda1830ca94090646115fef3f67fb23c716a4367e66",
    "appAfterSha256": "003d2eac0966ce7425f8a690bccbbe6e776957e4a4c347628d1a49e5cb57101c",
    "regressionFile": "study/interface/status.test.mjs",
    "regressionSha256": "efc671d0c998d7843a88be38e264880f655ddf7ed6baa71f9f0ae067e6f539d3",
    "patch": "interface-status.patch",
    "policy": [
      "Use one serial status read after a 1-second delay only while observing a busy server run without this page owning its run request. Stop scheduling at a validated idle response.",
      "Validate actual loopback status shape before treating it as idle; failed or malformed reads retain busy run/restore guards, show localized uncertainty and schedule another read.",
      "Abort current read, cancel scheduled timer and advance an epoch on page exit or stop; ignore late responses from an earlier epoch. Re-read when a page returns, unless its own run request is still in charge.",
      "On a failed stop, preserve the existing failure indication and resume observing the possibly active server.",
      "Keep page-owned run handling, same-origin token use, empty request bodies, evidence validation, historical restore and authority/proof requirements. Do not retrieve or invent result evidence from a status response."
    ],
    "limits": "This is a client-script status correction. The server, action implementation, source bridge, scientific candidate/checker/banks and local-EVM driver are unchanged.",
    "previousQueueSourceIdentityInputCaptureBridgeAndParentAliasCorrectionsRetained": true
  },
  "tests": {
    "runtime": "v24.19.0",
    "fixture": "The complete exact app.js bytes execute unchanged in a Node VM with controlled DOM/fetch/time dependencies. The script SHA-256 is printed. All responses, including fake action responses, are marked controlled test data. No browser, server, native worker, repository bridge, Git action, EVM or held objective runs.",
    "cases": [
      "An observer becomes idle without claiming fresh evidence or posting any action",
      "Slow status reads do not overlap; one still-busy reply schedules one next read",
      "Network/HTTP/malformed status failures preserve busy guards; EN/FR uncertainty clears on verified recovery",
      "Page exit before polling cancels its timer; page return re-reads status",
      "Page exit aborts in-flight read; late reply is ignored; return refreshes",
      "Stop cancels observation; stale busy reply cannot undo stopped state",
      "This page owns its original /api/run lifecycle, including across page exit/return",
      "Failed stop retains busy guards, truthfully reports failure and resumes status observation",
      "Restore is refused during observation and retains empty proof/authority historical requirements afterward"
    ],
