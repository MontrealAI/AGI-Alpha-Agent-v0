{
  "schema": "operational-amendment-output-schema/v1",
  "required_top_level": [
    "input_manifest_sha256",
    "authorization_record",
    "observed_anchor",
    "core_scenarios",
    "human_duration_comparison",
    "hybrid_complete_demand",
    "one_way_sensitivities",
    "limitations"
  ],
  "core_row_fields": [
    "price_basis",
    "scenario",
    "geography",
    "currency",
    "expected_acceptance_probability",
    "expected_attempts",
    "branch_costs",
    "variable_cost_by_component",
    "first_commission_total_cost",
    "first_commission_cost_per_expected_accepted",
    "annual_fixed_cost_by_component",
    "declared_demand_cost_per_expected_accepted",
    "declared_demand_feasible",
    "employer_minutes_per_requested",
    "employer_minutes_per_expected_accepted",
    "provider_human_minutes_per_expected_accepted",
    "all_human_minutes_per_expected_accepted",
    "accepted_conditional_turnaround_minutes",
    "all_request_turnaround_minutes",
    "failed_conditional_turnaround_minutes",
    "accepted_turnaround_median_minutes",
    "accepted_turnaround_p95_minutes",
    "worst_declared_path_minutes",
    "human_break_even_productive_minutes",
    "human_break_even_all_in_minutes",
    "capacity_requested",
    "capacity_expected_accepted",
    "capacity_binding_constraints",
    "capacity_residuals",
    "feasible_cost_per_expected_accepted"
  ],
  "null_rules": "Undefined denominators and absent observed fields remain null with a reason; do not coerce to zero.",
  "no_results_before_freeze": true,
  "hybrid_row_additional_fields": [
    "traditional_productive_minutes",
    "completed_demand_probability_assumed",
    "human_fallback_probability",
    "traditional_worker_minutes",
    "total_human_minutes",
    "hybrid_break_even_productive_minutes",
    "break_even_slope_status"
  ]
}
