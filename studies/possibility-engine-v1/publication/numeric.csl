<?xml version="1.0" encoding="utf-8"?>
<style xmlns="http://purl.org/net/xbiblio/csl" version="1.0" class="in-text" default-locale="en-US">
<info><title>Possibility Engine numeric</title><id>https://montreal.ai/styles/possibility-engine</id><updated>2026-10-28T00:00:00+00:00</updated></info>
<macro name="author"><names variable="author"><name initialize-with=". " and="text" delimiter=", "/><substitute><text variable="publisher"/></substitute></names></macro>
<citation collapse="citation-number"><sort><key variable="citation-number"/></sort><layout prefix="[" suffix="]" delimiter=", "><text variable="citation-number"/></layout></citation>
<bibliography hanging-indent="true" entry-spacing="1"><layout><text variable="citation-number" suffix=". "/><group delimiter=". "><text macro="author"/><text variable="title" font-style="italic"/><text variable="container-title"/><date variable="issued"><date-part name="year"/></date><text variable="URL"/></group><text value="."/></layout></bibliography>
</style>
