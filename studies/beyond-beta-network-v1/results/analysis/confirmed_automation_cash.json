  "definitions": {
    "countUnit": "Aggregated modeled job counts are descriptive;128independent worlds/scenario are the statistical units.",
    "attempt": "histories.jobs count; here all started because cancelledBeforeStart=0. Not prospects, quotes or completed useful outcomes.",
    "accepted": "Initially accepted proposed improvement, including modeled undetected invalid passes; observed error, administrative rejection and quarantine can prevent acceptance.",
    "useful": "Accepted and not latent invalid_pass. Model truth label, not an independent real customer quality measurement.",
    "materialErrors": "Jobs whose final plan.status.code is invalid_pass; includes rejected and non-inventive fallback outputs. Not all candidate errors or all human harms.",
    "falseAccepted": "latentAcceptedErrors/accepted: error-bearing outputs that passed initial acceptance, whether later refunded or not. Not residual unrefunded error after runoff.",
    "notAccepted": "attempted-accepted; includes valid no-improvement baselines, invalid outcomes, abstention and administrative rejection. Breakdown is not an exclusive classification in summary fields.",
    "baselineOnly": "Final no_improvement status. Such work does not earn the promised improvement payment.",
    "abstention": "Executed plans with status.abstained; precontract scope/capacity refusals are separate and absent from the attempted-job denominator.",
    "automation": "No provider human hours or routine review in the modeled design. automatedShare=1 conditional on usefulAccepted>0, null otherwise; it is not a measured automation-success rate.",
    "recovery": "Count of modeled bounded automated recovery actions admitted and charged; not count of independently proven customer harm reversals.",
    "latency": "Summary stores per-world job percentiles. A mean/median across those values is not a pooled percentile. Service hours are modeled resource occupancy from tokens, compute and parallelism, not measured clock time.",
    "profit": "collections-refunds-all accrued non-refund costs; includes acquisition, failed delivery, overhead, setup, historical allowance, and applicable capability costs. Assumed income-tax reserve is protected cash, not an expense already subtracted.",
    "terminalCash": "seed+profit+unpaid accrued obligations; unpaid=0 in these rows. Seed is not earned revenue.",
    "availableCash": "max(0,cash-unpaid-reserves-maintenance earmarks-unfinished execution commitments).",
    "earnedAvailable": "max(0,min(availableCash,profit-protected amounts)); excludes seed from earned surplus and can be0 in loss worlds.",
    "terminalReserves": "Here exactly minimum cash floor+23%ofpositive modeled operating profit; runoff leaves no recent-collection refund reserve, unfinished work or new-asset maintenance earmark.",
    "costPerUseful": "Pooled all-world accrued non-refund costs divided by pooled useful accepted outcomes, including costs of failed/zero-output worlds; refunds are contra-revenue rather than another resource cost.",
    "comparablePrice": "Useful-artifact cohort-weighted human reference and offered price; not mean of means, actual paid quote, or actual customer WTP.",
    "unavailableFromSummary": "Exact pooled job-latency percentile, mutually exclusive nonacceptance reasons, late-refund count and post-refund residual-error count are not available from these summary fields."
  }
}
